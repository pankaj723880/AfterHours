# Multi-Key YouTube Data API Configuration (10 keys comma-separated or discrete 1..10)
YOUTUBE_API_KEYS=your_key_1,your_key_2,your_key_3,your_key_4,your_key_5,your_key_6,your_key_7,your_key_8,your_key_9,your_key_10
YOUTUBE_KEY_1=your_youtube_api_key_1
YOUTUBE_KEY_2=your_youtube_api_key_2
YOUTUBE_KEY_3=your_youtube_api_key_3
GOOGLE_CLIENT_ID=your_google_client_id
PORT=5000
MONGODB_URI=your_mongodb_connection_string

# Gemini AI Multi-Key Configuration (5 keys comma-separated in GEMINI_API_KEYS or discrete 1..5)
GEMINI_API_KEYS=your_gemini_key_1,your_gemini_key_2,your_gemini_key_3,your_gemini_key_4,your_gemini_key_5
GEMINI_API_KEY=your_primary_gemini_api_key
GEMINI_API_KEY_2=your_secondary_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash

# Loopra Multi-Model AI Routing (Optional per-task overrides)
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_VOICE_MODEL=gemini-3.8-flash
GEMINI_STT_MODEL=gemini-3.5-transcribe
GEMINI_TRANSLATE_MODEL=gemini-3.1-flash-lite
GEMINI_COMPLEX_MODEL=gemini-4-argon
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
