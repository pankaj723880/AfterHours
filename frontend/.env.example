# Multi-Key YouTube Data API Configuration (10 keys comma-separated or discrete 1..10)
VITE_YOUTUBE_API_KEYS=your_key_1,your_key_2,your_key_3,your_key_4,your_key_5,your_key_6,your_key_7,your_key_8,your_key_9,your_key_10
VITE_YOUTUBE_KEY_1=your_youtube_api_key_1
VITE_YOUTUBE_KEY_2=your_youtube_api_key_2
VITE_YOUTUBE_KEY_3=your_youtube_api_key_3

# Multi-Key Gemini API Configuration (5 keys comma-separated)
VITE_GEMINI_API_KEYS=your_gemini_key_1,your_gemini_key_2,your_gemini_key_3,your_gemini_key_4,your_gemini_key_5

VITE_GOOGLE_CLIENT_ID=your_google_client_id
# On Vercel, set this to your Render backend URL (e.g. https://afterhours-api.onrender.com)
VITE_BACKEND_URL=https://afterhours-zvic.onrender.com
