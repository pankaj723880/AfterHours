{
  "name": "Loopra",
  "short_name": "Loopra",
  "description": "Stream music with immersive 3D visuals, live Indian radio, curated stations, and AI-powered music exploration.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#09090b",
  "theme_color": "#09090b",
  "lang": "en",
  "dir": "ltr",
  "categories": ["music", "entertainment", "utilities"],
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "file_handlers": [
    {
      "action": "/?action=open-file",
      "name": "Audio File",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "accept": {
        "audio/mpeg": [".mp3"],
        "audio/wav": [".wav"],
        "audio/ogg": [".ogg"]
      }
    }
  ],
  "share_target": {
    "action": "/?action=share-target",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "protocol_handlers": [
    {
      "protocol": "web+loopra",
      "url": "/?play=%s"
    }
  ],
  "icons": [
    {
      "src": "/icon-192.png",
      "type": "image/png",
      "sizes": "192x192",
      "purpose": "any"
    },
    {
      "src": "/icon-192.png",
      "type": "image/png",
      "sizes": "192x192",
      "purpose": "maskable"
    },
    {
      "src": "/icon-512.png",
      "type": "image/png",
      "sizes": "512x512",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "type": "image/png",
      "sizes": "512x512",
      "purpose": "maskable"
    },
    {
      "src": "/loopra-logo.png",
      "type": "image/png",
      "sizes": "1254x1254",
      "purpose": "any"
    },
    {
      "src": "/favicon.png",
      "type": "image/png",
      "sizes": "64x64",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Live Radio",
      "short_name": "Radio",
      "description": "Tune into live curated stations",
      "url": "/?view=radio",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png",
          "purpose": "any"
        }
      ]
    },
    {
      "name": "Discover Music",
      "short_name": "Discover",
      "description": "Explore trending tracks and playlists",
      "url": "/?view=discover",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png",
          "purpose": "any"
        }
      ]
    }
  ],
  "screenshots": [
    {
      "src": "/og-image.png",
      "sizes": "1200x630",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Loopra 3D Music Visualizer & Live Radio Player"
    },
    {
      "src": "/hero-cinematic.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Cinematic 3D Music Exploration"
    }
  ]
}
